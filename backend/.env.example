# =============================================================================
# Configuration de l'API - copier ce fichier en ".env" puis le compléter.
# Le fichier .env contient des secrets : il ne doit JAMAIS être publié.
# =============================================================================

# development ou production
NODE_ENV=development
PORT=3001

# Nombre de proxys devant l'API (0 en local, 1 chez la plupart des hébergeurs)
TRUST_PROXY=0

# Base de données (compte en lecture seule créé par database/01_creation_bdd.sql)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=trouve_ton_artisan
DB_USER=tta_api
DB_PASSWORD=A_remplacer_par_un_mot_de_passe_fort!

# Clé d'API partagée avec le front (même valeur que VITE_API_KEY), 32 caractères minimum.
# Pour en générer une : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY=

# Adresses autorisées à appeler l'API (séparées par des virgules)
CORS_ORIGINS=http://localhost:5173

# Envoi des e-mails (laisser SMTP_HOST vide en développement : les messages
# sont alors affichés dans la console au lieu d'être envoyés)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Trouve ton artisan <no-reply@trouve-ton-artisan.fr>"
# Si renseignée, tous les messages partent vers cette adresse (tests)
MAIL_REDIRECT_TO=

# Facultatif : chemin du site React compilé pour que l'API le serve aussi
# (ex : ../frontend/dist). Laisser vide si le site est hébergé à part.
FRONTEND_DIST=
