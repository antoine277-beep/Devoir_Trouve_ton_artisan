# Configuration du site React - copier ce fichier en ".env" puis le compléter.

# Adresse de l'API. Laisser vide si l'API est servie sur le même domaine que
# le site (en développement, Vite redirige /api vers http://localhost:3001).
VITE_API_URL=

# Clé d'accès à l'API : même valeur que API_KEY dans backend/.env
VITE_API_KEY=
